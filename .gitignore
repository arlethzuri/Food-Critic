.venv/
.env
.DS_Store
__pycache__/
*.pyc

# RAG index — rebuild with `python3 app/rag/ingest.py` (few min, needs internet)
data/RAG/chroma/
data/RAG/raw/

# DuckDB build artifact — rebuild with `python scripts/load_duckdb.py` (seconds, no internet)
db/*.duckdb

# Too large for git (see README's "Getting the data" section) — pull from
# the shared Drive link instead.
data/processed/review-Utah_food.csv
data/processed/review-Utah_10_food.csv

# Raw UCSD source archives — not read by any current script (only the
# exploratory data/ucsd_google_local/explore_ucsd_google_local.ipynb).
# Re-download from the link in data/ucsd_google_local/README.md if ever needed.
data/ucsd_google_local/*.gz
