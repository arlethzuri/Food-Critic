# Copy this file to app/.env and fill in one provider's key.
# Both have free tiers as of 2026 — no local model / GPU needed.

LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Google AI Studio / Gemini (https://aistudio.google.com/apikey) ---
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# --- Ollama (local, no key needed — original setup) ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
