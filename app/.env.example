# Copy this file to app/.env and fill in one provider's key.
# Groq and Google have free tiers as of 2026 — no local model / GPU needed.
# OpenAI does NOT — API usage bills a funded account even on a fresh key,
# unlike the ChatGPT web app's free tier.

LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) — free ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Google AI Studio / Gemini (https://aistudio.google.com/apikey) — free ---
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# --- OpenAI (https://platform.openai.com/api-keys) — paid, billing required ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra

# --- Anthropic (https://console.anthropic.com/settings/keys) — paid, billing required ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (local, no key needed — original setup) ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
